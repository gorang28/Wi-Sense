menu "WiSense Classifier"

    choice WISENSE_CLASSIFIER_BACKEND
        prompt "Classifier backend"
        default WISENSE_CLASSIFIER_PLACEHOLDER
        help
            Select the prediction source. Placeholder accepts UART keys
            e/p/m/f. TinyML will replace it later without changing callers.

        config WISENSE_CLASSIFIER_PLACEHOLDER
            bool "UART placeholder (e/p/m/f)"

        config WISENSE_CLASSIFIER_TINYML
            bool "On-device CSI model"
            help
                Classifies from the live CSI stream using the gradient-boosted
                cascade exported by python/export/export_cascade_c.py. Needs
                a receiver that feeds wisense_csi_infer_submit() — today that
                is firmware/csi_recv. Tune it under "WiSense CSI inference".
    endchoice

    config WISENSE_CLASSIFIER_UART_NUM
        int "Placeholder classifier UART port number"
        depends on WISENSE_CLASSIFIER_PLACEHOLDER
        range 0 2
        default 0
        help
            UART used to read single-character class keys from idf.py monitor.
            UART0 is the default console on most ESP32 DevKit boards. Ignored
            on boards whose console is the native USB-Serial/JTAG peripheral
            (CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG) — e.g. ESP32-S3-DevKitC-1 —
            since that peripheral is used instead.

    config WISENSE_CLASSIFIER_UART_BAUD
        int "Placeholder classifier UART baud rate"
        depends on WISENSE_CLASSIFIER_PLACEHOLDER
        default 115200
        help
            Must match the console baud rate used by idf.py monitor. Ignored
            when the console is native USB-Serial/JTAG (no baud rate concept).

endmenu
