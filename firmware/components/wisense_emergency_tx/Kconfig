menu "WiSense TX Emergency Orchestrator"

    config WISENSE_EMERGENCY_TX_TASK_STACK
        int "Orchestrator task stack (bytes)"
        default 4096
        range 2048 16384
        help
            Stack for the background emergency workflow task.

    config WISENSE_EMERGENCY_TX_TASK_PRIO
        int "Orchestrator task priority"
        default 5
        range 1 24
        help
            FreeRTOS priority. Keep below time-critical Wi-Fi work if needed.

    config WISENSE_EMERGENCY_TX_PRE_STREAM_DELAY_MS
        int "Delay after servo open before camera (ms)"
        default 2000
        range 0 60000
        help
            Short pause after opening the privacy flap so mechanics settle
            before camera/mic/stream start. Set 0 to skip.

endmenu
